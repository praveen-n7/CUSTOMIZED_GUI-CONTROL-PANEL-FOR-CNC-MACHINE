       <property name="styleSheet">
        <string notr="true">/* Normal State */
QPushButton {
    background-color: #ffcccc; /* Light Red/Pink */
    color: black;
    border: 2px solid #ff4d4d;
    font-weight: bold;
    border-radius: 4px;
}

/* When E-STOP is Engaged/Latched */
QPushButton:checked {
    background-color: #8b0000; /* Dark Red */
    color: white;
}

/* Visual feedback when clicking */
QPushButton:pressed {
    background-color: #4d0000;
}</string>
       </property>
       <property name="text">
        <string>E-STOP</string>
       </property>
       <property name="checkable">
        <bool>true</bool>
