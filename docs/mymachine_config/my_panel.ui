       <property name="styleSheet">
        <string notr="true">/* Not Homed */
QPushButton {
    background-color: #e1e1e1;
    color: black;
    border: 1px solid gray;
    border-radius: 4px;
}

/* Homed / Active */
QPushButton:checked {
    background-color: #3498db; /* Bright Blue */
    color: white;
}</string>
