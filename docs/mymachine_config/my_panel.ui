        <property name="styleSheet">
         <string notr="true">QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff2200, stop:0.45 #cc1100, stop:0.5 #aa0000, stop:1 #880000);
    color: white;
    border: 3px solid #440000;
    border-radius: 6px;
    font-weight: bold;
    font-size: 10pt;
    padding-left: 28px;
    text-align: left;
}
QPushButton::before {
    content: "";
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff4422, stop:0.45 #ee2200, stop:0.5 #cc1100, stop:1 #aa0000);
    border-color: #ff6666;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #770000, stop:1 #550000);
    border-color: #ff0000;
    padding-top: 3px;
}</string>
        </property>
        <property name="text">
         <string>⬡ E-STOP</string>
        </property>
       </widget>
