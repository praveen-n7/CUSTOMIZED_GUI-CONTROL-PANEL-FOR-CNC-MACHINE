   <widget class="QFrame" name="frame_tool_panel">
    <property name="geometry">
     <rect>
      <x>30</x>
      <y>60</y>
      <width>511</width>
      <height>595</height>
     </rect>
    </property>
    <property name="visible">
     <bool>false</bool>
    </property>
    <property name="styleSheet">
     <string notr="true">QFrame#frame_tool_panel {
    background-color: #1a1a2e;
    border: 2px solid #1c5980;
    border-radius: 4px;
}
QGroupBox {
    background-color: #16213e;
    border: 1px solid #1c5980;
    border-radius: 3px;
    color: #00aaff;
    font-size: 9pt;
    font-weight: bold;
    margin-top: 6px;
    padding-top: 4px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #00aaff;
}
QTableWidget {
    background-color: #0f3460;
    alternate-background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #1c5980;
    gridline-color: #2c5f8a;
    selection-background-color: #3498db;
    selection-color: white;
    font-size: 9pt;
}
QTableWidget::item {
    padding: 2px 4px;
}
QHeaderView::section {
    background-color: #0a1628;
    color: #00aaff;
    border: 1px solid #1c5980;
    padding: 3px;
    font-size: 8pt;
    font-weight: bold;
}
QLabel {
    color: #e0e0e0;
}
QPushButton {
    color: white;
    font-weight: bold;
    border: 2px solid #222222;
    border-radius: 4px;
    padding: 4px;
    background-color: #555555;
    font-size: 9pt;
}
QPushButton:hover {
    border-color: #ffffff;
}
QPushButton:pressed {
    background-color: #333333;
    padding-top: 6px;
    padding-left: 6px;
}</string>
    </property>
