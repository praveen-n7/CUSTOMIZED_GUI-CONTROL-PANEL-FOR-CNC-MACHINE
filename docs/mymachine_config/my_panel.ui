    <property name="styleSheet">
     <string notr="true">/* --- INACTIVE STATE (Default look from your image) --- */
QPushButton {
    background-color: #333333; /* Dark charcoal */
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;;
    font-size: 11pt;
    font-weight: bold;
    border: 1px solid #111111;
    padding: 10px;
    border-radius: 2px;
}

/* Hover effect */
QPushButton:hover {
    background-color: #444444;
    border: 1px solid #555555;
}

/* --- ACTIVE STATE (The Yellow &quot;On&quot; State) --- */
/* This triggers when the button is toggled/checked */
QPushButton:checked {
    background-color: #f1c40f; /* Vibrant Yellow */
    color: #000000;            /* Black text for high contrast on yellow */
    border: 2px solid #d4ac0d; /* Darker yellow border */
}

/* Optional: Different color when actually clicking down */
QPushButton:pressed {
    background-color: #f39c12; /* Orange-Yellow when pressed */
    color: #000000;
}</string>
