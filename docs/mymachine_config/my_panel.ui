  <property name="windowTitle">
   <string>QtVCP Panel - Virtual Machine - Manual, MDI &amp; Auto</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* Base style for all buttons */
QPushButton {
    color: white;
    font-weight: bold;
    border: 2px solid #222222;
    border-radius: 4px;
    padding: 5px;
    background-color: #555555;
}
#btn_fwd {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #2ecc71, stop:1 #27ae60);
    border-color: #1e8449;
}
#btn_rev {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #3498db, stop:1 #2980b9);
    border-color: #1c5980;
}
#btn_stop {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #e74c3c, stop:1 #c0392b);
    border-color: #943126;
}
QPushButton:hover { border-color: #ffffff; }
QPushButton:pressed {
    background-color: #333333;
    padding-top: 7px;
    padding-left: 7px;
}</string>
  </property>
