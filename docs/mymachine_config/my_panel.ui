                <property name="styleSheet">
                 <string notr="true">QFrame#toolInfoContainer {
    background-color: #1a2332;
    border: 1px solid #2980b9;
    border-radius: 4px;
}
QLabel#toolInfoHeading {
    color: #00aaff;
    font-size: 8pt;
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 0px;
}
QLabel[toolInfoRole=&quot;colHeader&quot;] {
    color: #7fb3d3;
    font-size: 7pt;
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 0px 0px 1px 0px;
}
QLabel[toolInfoRole=&quot;colValue&quot;] {
    color: #ffffff;
    font-size: 9pt;
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 0px;
}
QFrame[toolInfoRole=&quot;divider&quot;] {
    color: #2c4a6e;
    background-color: #2c4a6e;
    border: none;
    max-width: 1px;
    min-width: 1px;
}</string>
