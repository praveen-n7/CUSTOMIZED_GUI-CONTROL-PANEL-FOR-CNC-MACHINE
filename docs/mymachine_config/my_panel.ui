     <property name="styleSheet">
      <string notr="true">/* --- THE TRACK (The Groove) --- */
QSlider::groove:horizontal {
    border: 1px solid #3a3a3a;
    height: 8px;
    /* Creates a &quot;recessed&quot; look using a linear gradient */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                stop:0 #1a1a1a, stop:1 #333333);
    margin: 2px 0;
    border-radius: 4px;
}

/* --- THE FILLED PART (Left of the handle) --- */
QSlider::sub-page:horizontal {
    /* Glowing blue gradient for the 'active' side */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                stop:0 #5db7ff, stop:1 #2e78d2);
    border: 1px solid #1c5aa3;
    height: 8px;
    border-radius: 4px;
}

/* --- THE HANDLE (The Thumb) --- */
QSlider::handle:horizontal {
    /* Glossy glass effect */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #f6f7fa, stop:1 #babec5);
    border: 1px solid #777;
    width: 20px;
    height: 20px;
    margin: -7px 0; /* Centers the larger handle over the track */
    border-radius: 10px; /* Circular */
}

/* --- INTERACTIVE STATES --- */

/* Handle glowing on hover */
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #ffffff, stop:1 #d1d5db);
    border: 1px solid #4A90E2; /* Blue border on hover */
    box-shadow: 0 0 5px rgba(74, 144, 226, 0.5); /* Note: Qt simulates this via border */
}

/* Change the track color when the whole widget is hovered */
QSlider::groove:horizontal:hover {
    background: #252525;
}

/* Handle appearance when clicked/pressed */
QSlider::handle:horizontal:pressed {
    background: #2e78d2; /* Turns blue when you grab it */
    border: 1px solid #ffffff;
}</string>
